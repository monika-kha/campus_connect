# Flask production settings
FLASK_APP=run.py
FLASK_ENV=production
SECRET_KEY=replace-with-a-new-random-secret

# PostgreSQL (Amazon RDS)
# URL-encode special characters in the database password.
DATABASE_URL=postgresql+psycopg://campusconnect_app:URL_ENCODED_PASSWORD@your-rds-endpoint:5432/campusconnect?sslmode=require

# On EC2, prefer an attached IAM role for AWS access.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=replace-with-your-s3-bucket

# Backup object prefix in S3
BACKUP_PREFIX=backups/db/
